{
  "name": "suhbat-mobile",
  "version": "0.2.25",
  "private": true,
  "description": "Suhbat-dosh Android/iOS shell (Capacitor)",
  "scripts": {
    "offline": "node ../../scripts/sync-offline.mjs",
    "sync": "node ../../scripts/sync-offline.mjs && cap sync",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:debug:unix": "cd android && ./gradlew assembleDebug",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}