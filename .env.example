# Copy to .env and fill in. Never commit .env. Do not paste these values into chats or tickets.

# REQUIRED in production: >= 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# How one-time login codes are delivered:
#   log     - code is printed to the server log; the operator relays it (private/family installs)
#   webhook - POST {phone, text} to SMS_WEBHOOK_URL (your SMS gateway adapter)
#   dev     - code is returned in the API response. REFUSED when NODE_ENV=production.
OTP_MODE=log
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Allow new accounts to be created (set false once everyone has registered).
REGISTRATION_OPEN=true

# Max single upload, in MB.
MAX_UPLOAD_MB=50

# Set true when served over HTTPS (also set automatically in production): Secure cookies + HSTS.
COOKIE_SECURE=true
# Set true only when behind your own reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=false

# Docker publishing. Keep 127.0.0.1 if a reverse proxy runs on the same host; 0.0.0.0 to expose on the LAN.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# Only for `--profile https`:
DOMAIN=

# Backups kept by `npm run backup`.
BACKUP_KEEP=14
LOG_LEVEL=info

# Sign in with Telegram: create a bot with @BotFather, then run scripts/set-telegram-token.sh
TELEGRAM_BOT_TOKEN=

# Sign in with e-mail (Resend): run scripts/set-email-key.sh
RESEND_API_KEY=
EMAIL_FROM=Suhbat-dosh <no-reply@suhbat-dosh.uz>

# Telegram bridge (docs/tgbridge.md): a long random secret shared by the server and the tgbridge container.
# The Telegram key and api_id/api_hash go in .env.bridge, not here.
# BRIDGE_TOKEN=

# Copies on a second disk (a USB drive, another volume): mount it into the container with BACKUP_OFFSITE, then point the copies at it.
#   BACKUP_OFFSITE=/mnt/usb/suhbat-backup
#   BACKUP_MIRROR_DIR=/offsite/db            # every database snapshot is copied here too (same retention)
#   BACKUP_FILES_DIR=/offsite/files          # uploaded files are copied here instead of backups/files
#   BACKUP_MIRROR_MARKER=/offsite/.offsite   # an empty file you create on the disk: without it (disk unplugged) nothing is written and the admin is told

# The public address of the messenger: the server visits it from inside once a minute, like a visitor, and tells the administrators
# (in the messenger and in Telegram, if they signed in with it) when it stops answering and when it is back.
# PUBLIC_URL=https://suhbat-dosh.uz
